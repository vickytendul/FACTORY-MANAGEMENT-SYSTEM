{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // firebase | dual | supabase   - see Program.cs. Firebase stays the
  // default so a deploy of this code alone changes nothing; the switch is
  // the Skills__Source environment variable on the host.
  "Skills": {
    "Source": "firebase"
  },
  "Jwt": {
    "Issuer": "FactoryManagementSystem",
    "Audience": "FactoryManagementSystemClient",
    "ExpiryMinutes": 720
  }
}
